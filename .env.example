# ============================================================
# KeyLingo — variáveis de ambiente (copie para .env.local)
# NUNCA versione valores reais. Nenhuma destas variáveis é exposta ao navegador.
# ============================================================

# URL pública da aplicação (usada em links de e-mail e verificação de origem)
APP_URL=http://localhost:3000

# PostgreSQL (local ou Supabase: Project Settings → Database → Connection string)
DATABASE_URL=postgresql://keylingo:keylingo@localhost:5432/keylingo_dev
# Use "true" ao conectar no Supabase/hosts que exigem TLS
DATABASE_SSL=false
DATABASE_POOL_MAX=10

# De onde vem o IP real do cliente (rate limit e auditoria). Nunca confie em cabeçalhos que o cliente controla.
# cloudflare = CF-Connecting-IP | xff = último valor de X-Forwarded-For (atrás de 1 proxy reverso) | none
TRUST_PROXY=none

# Hosts https de onde o servidor pode buscar áudios cadastrados (separados por vírgula). Caminhos /audio/... sempre valem.
AUDIO_ALLOWED_HOSTS=

# Segredo para assinar/derivar tokens (gere com: openssl rand -hex 32)
AUTH_SECRET=troque-por-um-valor-aleatorio-de-64-caracteres

# ---------- E-mail ----------
# resend = API HTTP do Resend (use no Cloudflare) | smtp = servidor SMTP (só em hospedagem Node.js)
# log = grava no console/servidor (apenas desenvolvimento) | disabled
EMAIL_TRANSPORT=log
RESEND_API_KEY=
# Exemplo: smtps://usuario:senha@smtp.seuprovedor.com:465
SMTP_URL=
EMAIL_FROM="KeyLingo <no-reply@example.com>"

# ---------- Serviços de voz (servidor) ----------
# azure = Azure AI Speech (TTS + STT + avaliação de pronúncia) | none
SPEECH_PROVIDER=none
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=brazilsouth

# Permite que sessões de voz avaliadas apenas pelo reconhecimento do navegador
# (transcrição enviada pelo cliente, não verificável) entrem no ranking.
# Padrão seguro: false. Se "true", entradas aparecem marcadas como "não verificadas".
VOICE_ALLOW_CLIENT_RANKED=false

# ---------- Administração (usado pelo seed para criar o primeiro admin) ----------
ADMIN_EMAIL=
ADMIN_PASSWORD=
