{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "keylingo",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Banco de dados: Hyperdrive na frente do PostgreSQL (Supabase).
  // Crie com: npx wrangler hyperdrive create keylingo-db --connection-string="postgresql://..."
  // e cole o id retornado abaixo. "localConnectionString" é usado só no preview local.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "COLE_AQUI_O_ID_DO_HYPERDRIVE",
      "localConnectionString": "postgresql://keylingo:keylingo@localhost:5432/keylingo_dev"
    }
  ],
  // Variáveis não secretas. Segredos (AUTH_SECRET, RESEND_API_KEY, AZURE_SPEECH_KEY)
  // são definidos com: npx wrangler secret put NOME
  "vars": {
    "APP_URL": "https://keylingo.SEU-SUBDOMINIO.workers.dev",
    "EMAIL_TRANSPORT": "resend",
    "TRUST_PROXY": "cloudflare",
    "EMAIL_FROM": "KeyLingo <onboarding@resend.dev>",
    "SPEECH_PROVIDER": "none",
    "VOICE_ALLOW_CLIENT_RANKED": "false"
  },
  "observability": { "enabled": true }
}
